{
    "name": "QR Code Generator",
    "version": "1.3.0",
    "description": "Create and copy QR codes. Export PNG, JPEG, WebP or SVG. Customize cards with size sliders and save your work locally.",
    "manifest_version": 3,
    "permissions": ["activeTab"],
    "author": "Axinomyus",
    "homepage_url": "https://www.axinomyus.com/products/qr-code-generator-extension",
    "action":{
        "default_popup": "index.html",
        "default_title": "QR Code Generator",
        "default_icon":{
            "16":"img/icon-16.png",
            "32":"img/icon-32.png"
        }
    },
    "icons":{
        "16":"img/icon-16.png",
        "32":"img/icon-32.png",
        "48":"img/icon-48.png",
        "128":"img/icon.png"
    }
}
